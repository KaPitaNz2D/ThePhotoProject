{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "16c09e8f8b454571b9b4a4dc5c70b390",
    "m_Group": {
        "m_Id": "37a711702be249e19cd25a2711811936"
    },
    "m_Name": "StormWind (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -3292.0,
            "y": 488.0,
            "width": 217.0,
            "height": 494.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "43bde48cbe6f404a867c37058d8f8f96"
        },
        {
            "m_Id": "4682e29941b648a786d5d3fcf3b45077"
        },
        {
            "m_Id": "9c95a567ef394f25998581f95c049c97"
        },
        {
            "m_Id": "a5c421d0c3a34d748e5e1f0d865c71bb"
        },
        {
            "m_Id": "4390e0cac39f4d1dba05283dd7fba929"
        },
        {
            "m_Id": "c17fe85c20a8402ca533a1b4c2c94724"
        },
        {
            "m_Id": "084383567f6946d38e70d75fc5942d07"
        },
        {
            "m_Id": "d16343fbc49347eb866ff9d31c288d96"
        },
        {
            "m_Id": "78a276b2a11a46758374d9feb750aa17"
        },
        {
            "m_Id": "e8625d20ab404571845d42ea288f2504"
        },
        {
            "m_Id": "cff0e7d4829244c4becdf465a84333c3"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "StormWind",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Storm wind for leaf cards: directional bend + gust envelope + high-frequency flutter.\n// Returns an OBJECT-space offset, because VertexDescription.Position is object space.\n\nfloat2 dir = WindDir;\nfloat dirLen = length(dir);\ndir = dirLen > 1e-5 ? dir / dirLen : float2(1.0, 0.0);\n\nfloat3 dirOS = TransformWorldToObjectDir(float3(dir.x, 0.0, dir.y), true);\nfloat3 upOS  = TransformWorldToObjectDir(float3(0.0, 1.0, 0.0), true);\n\n// --- Gust: large-scale front sweeping downwind through world space.\nfloat2 gUV = WorldPos.xz * GustScale - dir * (TimeIn * WindSpeed * 0.25);\nfloat2 gI = floor(gUV);\nfloat2 gF = frac(gUV);\ngF = gF * gF * (3.0 - 2.0 * gF);\nfloat4 gH = frac(sin(float4(\n    dot(gI + float2(0.0, 0.0), float2(127.1, 311.7)),\n    dot(gI + float2(1.0, 0.0), float2(127.1, 311.7)),\n    dot(gI + float2(0.0, 1.0), float2(127.1, 311.7)),\n    dot(gI + float2(1.0, 1.0), float2(127.1, 311.7)))) * 43758.5453);\nfloat gust = lerp(lerp(gH.x, gH.y, gF.x), lerp(gH.z, gH.w, gF.x), gF.y);\ngust = lerp(0.35, 1.0, gust);   // a storm never fully calms\n\n// --- Flutter: high-frequency chaos, keyed off object position so each card differs.\nfloat2 fUV = ObjPos.xz * 8.0 + dir * (TimeIn * WindSpeed * 4.0);\nfloat2 fI = floor(fUV);\nfloat2 fF = frac(fUV);\nfF = fF * fF * (3.0 - 2.0 * fF);\nfloat4 fH = frac(sin(float4(\n    dot(fI + float2(0.0, 0.0), float2(127.1, 311.7)),\n    dot(fI + float2(1.0, 0.0), float2(127.1, 311.7)),\n    dot(fI + float2(0.0, 1.0), float2(127.1, 311.7)),\n    dot(fI + float2(1.0, 1.0), float2(127.1, 311.7)))) * 43758.5453);\nfloat flutter = lerp(lerp(fH.x, fH.y, fF.x), lerp(fH.z, fH.w, fF.x), fF.y) - 0.5;\n\n// --- Combine. The 0.5 / 0.15 constants keep the 0-1 sliders out of \"metres\" territory.\nfloat3 bend   = dirOS * (gust * WindBend * 0.5);\nfloat3 jitter = (dirOS * 0.7 + upOS * 0.3) * (flutter * WindStrength * 0.15 * gust);\n\nfloat mask = lerp(1.0, saturate(UV.y), TipMask);\nOffset = (bend + jitter) * mask;"
}

